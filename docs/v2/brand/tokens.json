{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "GreeCheck V2 design tokens — GreeCheck Ultimate / Calm Radicalism. Source of truth for docs/v2/04-design-system.md. CSS variable mapping: token path gc.color.natural -> --gc-natural. Existing app tokens in src/app/globals.css keep their names; NEW tokens (pastel.*, typography display, spacing scale) extend them.",
  "gc": {
    "color": {
      "canvas": {
        "bg": { "$type": "color", "$value": "#FAFAF7", "$description": "warm apple-white canvas · dark: #090C0B" },
        "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "level 1 cards · dark: #121614" },
        "surface2": { "$type": "color", "$value": "#F5F6F4", "$description": "level 2 insets · dark: #1A1F1C" },
        "surface3": { "$type": "color", "$value": "#EEF0EC", "$description": "level 3 pressed · dark: #212724" },
        "ink": { "$type": "color", "$value": "#101312", "$description": "primary text · dark: #F0F4F1" },
        "muted": { "$type": "color", "$value": "#66706A", "$description": "secondary text · dark: #96A09A" },
        "line": { "$type": "color", "$value": "#E8EAE7", "$description": "hairline borders · dark: #262C29" }
      },
      "brand": {
        "natural": { "$type": "color", "$value": "#2ECC71", "$description": "brand green — everyday accent, fills, mark leaf" },
        "naturalStrong": { "$type": "color", "$value": "#15803D", "$description": "AA text green on white (5.0:1) · dark: #4ADE80" },
        "neon": { "$type": "color", "$value": "#39FF88", "$description": "MOTION ONLY: scan detection, focus, success, progress. Never static decoration" },
        "deep": { "$type": "color", "$value": "#0B3D2E", "$description": "deep green — hero surfaces, logo ink, PWA icon field" }
      },
      "score": {
        "a": { "$type": "color", "$value": "#16A34A" },
        "b": { "$type": "color", "$value": "#84CC16" },
        "c": { "$type": "color", "$value": "#EAB308" },
        "d": { "$type": "color", "$value": "#F97316" },
        "e": { "$type": "color", "$value": "#EF4444" },
        "aInk": { "$type": "color", "$value": "#15803D", "$description": "AA-safe text pair — always use *Ink for text" },
        "bInk": { "$type": "color", "$value": "#4D7C0F" },
        "cInk": { "$type": "color", "$value": "#A16207" },
        "dInk": { "$type": "color", "$value": "#C2410C" },
        "eInk": { "$type": "color", "$value": "#DC2626" }
      },
      "verdict": {
        "positive": { "$type": "color", "$value": "{gc.color.score.a}" },
        "caution": { "$type": "color", "$value": "{gc.color.score.c}" },
        "negative": { "$type": "color", "$value": "{gc.color.score.e}" },
        "unknown": { "$type": "color", "$value": "#5B655F", "$description": "unknown is neutral, NEVER styled as negative · dark: #A6B0AA" }
      },
      "pastel": {
        "$description": "NEW · dashboard tint palette — card backgrounds for sub-scores, GreeImpact, compatibility and illustration fills. Text on pastel always uses the paired ink token.",
        "mint": { "$type": "color", "$value": "#DCF2E3", "$description": "nutrition · ink pair: score.aInk" },
        "sage": { "$type": "color", "$value": "#E6EFE0", "$description": "naturality/organic · ink pair: score.bInk" },
        "sand": { "$type": "color", "$value": "#F3EDE0", "$description": "processing · ink pair: score.cInk" },
        "butter": { "$type": "color", "$value": "#F8F1DC", "$description": "additives · ink pair: score.cInk" },
        "sky": { "$type": "color", "$value": "#E1EEF2", "$description": "GreeImpact / environment · ink pair: #1E6B7A" },
        "skyInk": { "$type": "color", "$value": "#1E6B7A", "$description": "AA text on sky and white" },
        "blush": { "$type": "color", "$value": "#F6E3DC", "$description": "compatibility alerts · ink pair: score.dInk" },
        "stone": { "$type": "color", "$value": "#ECEDEA", "$description": "unknown/neutral · ink pair: verdict.unknown" }
      },
      "focus": { "$type": "color", "$value": "{gc.color.brand.naturalStrong}", "$description": "focus ring · dark: neon" }
    },
    "typography": {
      "fontFamily": {
        "display": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "Times New Roman", "serif"], "$description": "NEW · editorial serif — hero headlines, verdicts, marketing, score hero numerals. Variable font, SIL OFL. Latin only; ar falls back to sansArabic display weights" },
        "sans": { "$type": "fontFamily", "$value": ["Inter", "SF Pro Display", "system-ui", "sans-serif"], "$description": "UI workhorse — everything interactive" },
        "sansArabic": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "system-ui", "sans-serif"], "$description": "ar locale, both display and UI roles" },
        "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "barcodes, E-numbers, tabular data only" }
      },
      "scale": {
        "$description": "rem-based · [size, lineHeight, letterSpacing, weight]",
        "scoreHero": { "$type": "typography", "$value": { "fontSize": "4rem", "lineHeight": 1, "letterSpacing": "-0.03em", "fontWeight": 600, "fontFamily": "{gc.typography.fontFamily.display}" } },
        "displayXl": { "$type": "typography", "$value": { "fontSize": "3rem", "lineHeight": 1.05, "letterSpacing": "-0.025em", "fontWeight": 600, "fontFamily": "{gc.typography.fontFamily.display}" } },
        "display": { "$type": "typography", "$value": { "fontSize": "2.25rem", "lineHeight": 1.1, "letterSpacing": "-0.02em", "fontWeight": 600, "fontFamily": "{gc.typography.fontFamily.display}" } },
        "title": { "$type": "typography", "$value": { "fontSize": "1.5rem", "lineHeight": 1.2, "letterSpacing": "-0.015em", "fontWeight": 650, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "heading": { "$type": "typography", "$value": { "fontSize": "1.25rem", "lineHeight": 1.3, "letterSpacing": "-0.01em", "fontWeight": 600, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "bodyLg": { "$type": "typography", "$value": { "fontSize": "1.125rem", "lineHeight": 1.55, "letterSpacing": "0", "fontWeight": 400, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "body": { "$type": "typography", "$value": { "fontSize": "1rem", "lineHeight": 1.5, "letterSpacing": "0", "fontWeight": 400, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "small": { "$type": "typography", "$value": { "fontSize": "0.875rem", "lineHeight": 1.45, "letterSpacing": "0", "fontWeight": 450, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "caption": { "$type": "typography", "$value": { "fontSize": "0.75rem", "lineHeight": 1.35, "letterSpacing": "0.01em", "fontWeight": 500, "fontFamily": "{gc.typography.fontFamily.sans}" } },
        "overline": { "$type": "typography", "$value": { "fontSize": "0.6875rem", "lineHeight": 1.3, "letterSpacing": "0.08em", "fontWeight": 600, "textTransform": "uppercase", "fontFamily": "{gc.typography.fontFamily.sans}" } }
      }
    },
    "spacing": {
      "$description": "4px base grid. Tailwind default scale is compatible; these are the sanctioned steps.",
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "20": { "$type": "dimension", "$value": "80px" },
      "pagePaddingMobile": { "$type": "dimension", "$value": "16px" },
      "pagePaddingDesktop": { "$type": "dimension", "$value": "24px" },
      "sectionGap": { "$type": "dimension", "$value": "32px" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "0.625rem", "$description": "--gc-r-sm · chips, inputs, focus outline" },
      "md": { "$type": "dimension", "$value": "1rem", "$description": "--gc-r-md · buttons, small cards" },
      "lg": { "$type": "dimension", "$value": "1.5rem", "$description": "--gc-r-lg · cards, sheets" },
      "xl": { "$type": "dimension", "$value": "2rem", "$description": "--gc-r-xl · hero cards, sheet tops" },
      "full": { "$type": "dimension", "$value": "9999px", "$description": "pills, score ring, nav dock" }
    },
    "shadow": {
      "soft": { "$type": "shadow", "$value": "0 1px 2px rgb(16 19 18 / 0.04), 0 8px 24px -12px rgb(16 19 18 / 0.10)", "$description": "--gc-shadow-1 · resting cards" },
      "raised": { "$type": "shadow", "$value": "0 2px 4px rgb(16 19 18 / 0.05), 0 16px 36px -16px rgb(11 61 46 / 0.22)", "$description": "--gc-shadow-2 · sheets, popovers" },
      "float": { "$type": "shadow", "$value": "0 4px 10px rgb(16 19 18 / 0.07), 0 28px 60px -24px rgb(11 61 46 / 0.30)", "$description": "--gc-shadow-3 · hero, dialogs" },
      "glow": { "$type": "shadow", "$value": "0 0 0 1px rgb(57 255 136 / 0.35), 0 0 28px -4px rgb(57 255 136 / 0.45)", "$description": "MOTION ONLY: detection + success moments" },
      "edgeLight": { "$type": "shadow", "$value": "inset 0 1px 0 rgb(255 255 255 / 0.35)", "$description": "soft-3D top highlight — pair with soft/raised, never alone" }
    },
    "motion": {
      "duration": {
        "fast": { "$type": "duration", "$value": "140ms", "$description": "micro feedback: press, toggle, hover" },
        "base": { "$type": "duration", "$value": "260ms", "$description": "standard transitions: sheets, cards, reveals" },
        "slow": { "$type": "duration", "$value": "480ms", "$description": "hero moments: verdict reveal, score count-up start" },
        "pulse": { "$type": "duration", "$value": "1200ms", "$description": "NEW · GreePulse breathing loop period" }
      },
      "easing": {
        "out": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1], "$description": "default — everything entering or settling" },
        "spring": { "$type": "cubicBezier", "$value": [0.34, 1.4, 0.4, 1], "$description": "playful overshoot — success, podium, add-to actions" },
        "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1], "$description": "NEW · accelerate out — dismissals" }
      }
    },
    "size": {
      "touchTarget": { "$type": "dimension", "$value": "44px", "$description": "minimum interactive size, all pointers" },
      "touchGap": { "$type": "dimension", "$value": "8px", "$description": "minimum gap between adjacent targets" },
      "bottomNavHeight": { "$type": "dimension", "$value": "64px", "$description": "+ env(safe-area-inset-bottom)" },
      "scoreRingSm": { "$type": "dimension", "$value": "48px" },
      "scoreRingMd": { "$type": "dimension", "$value": "72px" },
      "scoreRingHero": { "$type": "dimension", "$value": "128px" }
    },
    "breakpoint": {
      "mobileMin": { "$type": "dimension", "$value": "360px", "$description": "design floor — everything must work here" },
      "md": { "$type": "dimension", "$value": "640px", "$description": "large phone / small tablet" },
      "lg": { "$type": "dimension", "$value": "1024px", "$description": "desktop: side-nav replaces bottom nav" },
      "xl": { "$type": "dimension", "$value": "1200px", "$description": "container max-width" }
    }
  }
}
