# GreeCheck — no user backend. Only public data sources.
# All variables are OPTIONAL: the app ships with sensible defaults and runs
# on Vercel with no environment configuration at all.

# Open Food Facts product/base API (client + server). Public.
NEXT_PUBLIC_OFF_BASE_URL=https://world.openfoodfacts.org

# Open Food Facts full-text search endpoint (server proxy only).
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org

# User-Agent sent to Open Food Facts from server proxy routes (required by OFF etiquette).
OFF_USER_AGENT=GreeCheck/0.1 (contact@greecheck.app)
