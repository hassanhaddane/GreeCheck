# GreeCheck v3. Keep .env.local out of Git.
# Public canonical origin used on all environments, including preview.
NEXT_PUBLIC_SITE_URL=https://gree-check.vercel.app

# Server-only Open Food Facts configuration. Defaults shown.
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
OFF_PRODUCT_API_VERSION=v3
OFF_USER_AGENT="GreeCheck/3.0 (+https://github.com/hassanhaddane/GreeCheck)"

# USDA fallback is disabled until a server-only FoodData Central key is present.
USDA_FDC_API_KEY=

# Optional Discover providers. Public Nominatim is excluded.
# Set a provisioned Nominatim-compatible /search endpoint to enable city search.
NOMINATIM_API_URL=
# An optional preferred Overpass mirror. Built-in mirrors remain fallbacks.
OVERPASS_API_URL=
OSM_USER_AGENT="GreeCheck/3.0 (+https://github.com/hassanhaddane/GreeCheck)"

# Set only a real HTTPS donation page. Empty keeps the action disabled.
GREECHECK_DONATION_URL=

# Experimental OCR stays off unless explicitly enabled in a deployment.
NEXT_PUBLIC_OCR_BETA=0

# Vercel provides VERCEL_ENV and NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA when system
# variables are exposed. Preview gets noindex and each build has its own PWA cache.
